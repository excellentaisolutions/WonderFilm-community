{
  "name": "wonderfilm",
  "productName": "WonderFilm",
  "version": "0.3.0",
  "private": true,
  "description": "Editor de video de escritorio",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node qa/editor-smoke.cjs",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.31",
    "tailwindcss": "3.4",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.15"
  },
  "author": "Oscar Garcia",
  "build": {
    "appId": "com.wonderfilm.editor",
    "productName": "WonderFilm",
    "copyright": "Copyright 2026 Oscar Garcia · Apache-2.0",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "agents/**",
      "resources/icon.png",
      "resources/THIRD-PARTY-NOTICES.txt",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "WonderFilm-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WonderFilm",
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE"
    },
    "fileAssociations": [
      {
        "ext": "wonderfilm",
        "name": "Proyecto de WonderFilm",
        "description": "Proyecto de WonderFilm",
        "role": "Editor",
        "icon": "resources/icon.png"
      }
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "licenses/LICENSE.txt"
      },
      {
        "from": "../NOTICE",
        "to": "licenses/NOTICE.txt"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "licenses/THIRD-PARTY-NOTICES.md"
      }
    ]
  }
}
